# Copy to .env.local for local runs:  cp .env.example .env.local
#
# .env.local is gitignored. Never commit real values.

# ---- Clip analysis provider ----
# AgentRouter is the DEFAULT and is used when LLM_BASE_URL/LLM_API_KEY are unset.
# Used by worker.py for the deepseek-v4-flash model.
AGENTROUTER_API_KEY=
# Optional; defaults to https://agentrouter.org/v1 if unset.
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# ---- Optional: run analysis on a different OpenAI-compatible provider ----
# Set BOTH to bypass AgentRouter entirely (it has been returning
# 401 "unauthorized client detected" for every key). Any OpenAI-compatible
# endpoint works -- DeepSeek direct, OpenAI, OpenRouter, Groq.
# When these are set, the AgentRouter-specific headers are NOT sent.
#   DeepSeek direct: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   OpenAI:          LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
# Optional; must match the provider above. Defaults to deepseek-v4-flash.
LLM_MODEL=

# ---- OpenAI (Whisper transcript fallback) ----
# Only needed when YouTube captions are unavailable or the source is not YouTube.
# Without it, non-YouTube URLs cannot be processed at all.
OPENAI_API_KEY=

# ---- Supabase (job queue) ----
# The worker needs the SERVICE ROLE key: it must bypass RLS to claim and update
# jobs. Keep this out of any NEXT_PUBLIC_ variable and out of the browser.
# These are normally injected by the GitHub Actions workflow from repo secrets,
# not read from a file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Next.js frontend (Vercel environment variables, not this file) ----
# The browser client in utils/supabase/client.ts reads these. They are NOT
# secrets (the anon key is public by design), but they must be set in Vercel or
# login/signup will fall back to placeholder values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Optional: n8n bridge used by app/api/webhook/route.js ----
N8N_WEBHOOK_URL=
