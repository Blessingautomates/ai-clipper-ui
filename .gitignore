# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented template must ship: `.env*` above would otherwise
# silently swallow it, so the file would exist locally and never reach the repo.
!.env.example

# python (worker.py / transcript.py)
__pycache__/
*.py[cod]
.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local credentials (the empty .env.example template remains tracked)
.aws/
.credentials/
credentials*.json
service-account*.json
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.pgpass
.netrc

# Local source videos, rendered clips, and integration proof output
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4v
*.video
/videos/
/clips/
/clipper-output/
/clipper-mvp-proof-*/
clips.json

# Local backups and database dumps; keep migration/verification SQL sources
backups/
backup/
dumps/
backup*.sql
dump*.sql
*_backup.sql
*_dump.sql
*.dump
*.backup
*.bak
*.sql.gz
*.sql.gpg
*.dump.gpg
*.backup.gpg
*.gpg
*.sql.enc
*.tar
*.tar.gz
*.tgz

# Temporary test/runtime files
/tmp/
/temp/
*.tmp
*.temp
*.log
*.swp
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
/dist/
