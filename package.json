  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:api": "node --experimental-vm-modules --test tests/generate-route.test.mjs tests/jobs-route.test.mjs tests/worker-dispatch.test.mjs",
